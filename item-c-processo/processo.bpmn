<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_TrabalhoFinal" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Grupo">
    <bpmn:participant id="Pool_Grupo" name="Grupo — Trabalho final (NuPay e cartão)" processRef="Proc_TrabalhoFinal" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_TrabalhoFinal" name="Processo do grupo — Trabalho final" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Papeis">
      <bpmn:lane id="L_GP" name="Gerente do projeto">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X_Ult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_MP" name="Modelador de processos">
        <bpmn:flowNodeRef>T_Model</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AN" name="Analista de negócios">
        <bpmn:flowNodeRef>T_Desaf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Serv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_EP" name="Engenheiro de prompts">
        <bpmn:flowNodeRef>T_Prompt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Gerar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AF" name="Analista financeiro">
        <bpmn:flowNodeRef>T_Custo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_RD" name="Redator">
        <bpmn:flowNodeRef>T_ItemC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Prop</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AU" name="Auditor">
        <bpmn:flowNodeRef>T_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Achad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X_Crit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_RV" name="Revisor">
        <bpmn:flowNodeRef>P_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Rev</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_GR" name="Guardião do repositório">
        <bpmn:flowNodeRef>T_Diar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Início do trabalho (3/11)">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="M1">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Plan" name="Planejar a semana e atualizar o cronograma">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P_Split">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_Model" name="Modelar processo e papéis (BPMN)">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Desaf" name="Identificar os desafios">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Prompt" name="Montar prompt com os 8 campos">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Gerar" name="Gerar rascunho no LLM gerador">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Serv" name="Desenhar os serviços da consultoria">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Custo" name="Estimar esforço, custos e cronograma">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ItemC" name="Redigir o Item C (até 3 páginas)">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M2">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Prop" name="Redigir a proposta (Item A, até 7 páginas)">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Audit" name="Auditar no LLM auditor (Persona de Auditor)">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Achad" name="Registrar e classificar os achados">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="X_Crit" name="Achado crítico aceito?" default="F16">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P_Join">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_Rev" name="Revisão cruzada por outro ator">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Diar" name="Commit, entrada no diário e tag da semana">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="X_Ult" name="Última semana?" default="F22">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Trabalho entregue (1/12)">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="M1" />
    <bpmn:sequenceFlow id="F02" sourceRef="M1" targetRef="T_Plan" />
    <bpmn:sequenceFlow id="F03" sourceRef="T_Plan" targetRef="P_Split" />
    <bpmn:sequenceFlow id="F04" sourceRef="P_Split" targetRef="T_Model" />
    <bpmn:sequenceFlow id="F05" sourceRef="P_Split" targetRef="T_Desaf" />
    <bpmn:sequenceFlow id="F06" sourceRef="T_Desaf" targetRef="T_Prompt" />
    <bpmn:sequenceFlow id="F07" sourceRef="T_Prompt" targetRef="T_Gerar" />
    <bpmn:sequenceFlow id="F08" sourceRef="T_Gerar" targetRef="T_Serv" />
    <bpmn:sequenceFlow id="F09" sourceRef="T_Serv" targetRef="T_Custo" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_Custo" targetRef="M2" />
    <bpmn:sequenceFlow id="F11" sourceRef="M2" targetRef="T_Prop" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_Prop" targetRef="T_Audit" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Audit" targetRef="T_Achad" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_Achad" targetRef="X_Crit" />
    <bpmn:sequenceFlow id="F15" name="Sim" sourceRef="X_Crit" targetRef="M2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">achado crítico aceito</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" name="Não" sourceRef="X_Crit" targetRef="P_Join" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_Model" targetRef="T_ItemC" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_ItemC" targetRef="P_Join" />
    <bpmn:sequenceFlow id="F19" sourceRef="P_Join" targetRef="T_Rev" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_Rev" targetRef="T_Diar" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_Diar" targetRef="X_Ult" />
    <bpmn:sequenceFlow id="F22" name="Não" sourceRef="X_Ult" targetRef="M1" />
    <bpmn:sequenceFlow id="F23" name="Sim" sourceRef="X_Ult" targetRef="End">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">última semana (1/12)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="A1"><bpmn:text>Ciclo semanal: cada entrega fecha numa terça-feira até 1/12.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A1" sourceRef="Start" targetRef="A1" />
    <bpmn:textAnnotation id="A2"><bpmn:text>Cada commit gera uma entrada no diário (README).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A2" sourceRef="T_Diar" targetRef="A2" />
    <bpmn:textAnnotation id="A3"><bpmn:text>Itens A e C correm em paralelo.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A3" sourceRef="P_Split" targetRef="A3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1" name="Processo do grupo">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_Grupo">
